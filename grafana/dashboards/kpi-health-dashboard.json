      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_max((sum(rate(http_request_duration_seconds_count{job=~\"${service}\", code=~\"2..|3..\"}[2m])) or vector(1)) / (sum(rate(http_request_duration_seconds_count{job=~\"${service}\"}[2m])) or vector(1)) * 100, 100)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
