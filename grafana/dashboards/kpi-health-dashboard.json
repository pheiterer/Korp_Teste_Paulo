            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Correlation ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "🔍 Rastrear logs desta transação (${__value.text}) no Explore",
                    "url": "/explore?left=%5B%22now-1h%22,%22now%22,%22Loki%22,%7B%22expr%22:%22%7Bcontainer=~%5C%22gateway-api%7Cfaturamento-api%7Cestoque-api%7Cfrontend-web%5C%22%7D%20%7C=%20%5C%22${__value.text}%5C%22%22%7D%5D"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status Final"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "Fechada": {
                        "color": "green",
                        "index": 0,
                        "text": "🟢 Fechada (Sucesso)"
                      },
                      "FECHADA": {
                        "color": "green",
                        "index": 1,
                        "text": "🟢 Fechada (Sucesso)"
                      },
                      "Cancelada": {
                        "color": "red",
                        "index": 2,
                        "text": "🔴 Cancelada (Falha)"
                      },
                      "CANCELADA": {
                        "color": "red",
                        "index": 3,
                        "text": "🔴 Cancelada (Falha)"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tempo Total (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
