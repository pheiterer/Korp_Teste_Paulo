		{
			"name": "2. Gestao de Notas Fiscais (Issue 9)",
			"item": [
				{
					"name": "2.1 Criar Nota Fiscal (Status Aberta)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itens\": [\n    {\n      \"produto_id\": 1,\n      \"codigo_produto\": \"PRD-001\",\n      \"quantidade\": 2,\n      \"preco_unitario\": 50.00\n    },\n    {\n      \"produto_id\": 2,\n      \"codigo_produto\": \"PRD-002\",\n      \"quantidade\": 1,\n      \"preco_unitario\": 30.00\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais"
							]
						},
						"description": "Cria uma nova Nota Fiscal no SQL Server com status inicial 'Aberta' e calcula o valor total (130.00)."
					},
					"response": []
				},
				{
					"name": "2.2 Listar Todas as Notas Fiscais",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais"
							]
						},
						"description": "Retorna a lista de todas as Notas Fiscais salvas com seus respectivos itens."
					},
					"response": []
				},
				{
					"name": "2.3 Obter Nota Fiscal por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais",
								"1"
							]
						},
						"description": "Retorna os detalhes da Nota Fiscal de ID 1."
					},
					"response": []
				},
				{
					"name": "2.4 Imprimir / Finalizar Nota Fiscal (Publica Evento no RabbitMQ)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Correlation-ID",
								"value": "postman-corr-id-12345",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais/1/imprimir",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais",
								"1",
								"imprimir"
							]
						},
						"description": "Verifica se a Nota Fiscal 1 esta 'Aberta', altera o status para 'Fechada' no SQL Server e dispara o evento NotaFiscalEmitidaEvent para o RabbitMQ com X-Correlation-ID."
					},
					"response": []
				}
			]
		},
		{
