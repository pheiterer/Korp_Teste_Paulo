{
	"info": {
		"_postman_id": "f8a9e102-3c41-4b89-a21b-90f7a6543210",
		"name": "API de Faturamento (Go / Golang - Completa)",
		"description": "Collection completa do Postman para testar os endpoints da API RESTful de Faturamento em Go, incluindo criação de notas fiscais, consulta por ID/UUID, listagem, impressão/finalização e disparo de eventos para o RabbitMQ.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8082",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Observabilidade & Saúde",
			"item": [
				{
					"name": "1.1 Health Check (Ping)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Verifica a saúde básica do servidor HTTP de Faturamento em Go."
					},
					"response": []
				},
				{
					"name": "1.2 API Ping (v1)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/ping",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"ping"
							]
						},
						"description": "Endpoint de teste de conectividade da versão v1 da API."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Gestão de Notas Fiscais",
			"item": [
				{
					"name": "2.1 Criar Nota Fiscal (Status Aberta)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itens\": [\n    {\n      \"produto_id\": 1,\n      \"codigo_produto\": \"PRD-001\",\n      \"quantidade\": 2,\n      \"preco_unitario\": 50.00\n    },\n    {\n      \"produto_id\": 2,\n      \"codigo_produto\": \"PRD-002\",\n      \"quantidade\": 1,\n      \"preco_unitario\": 30.00\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais"
							]
						},
						"description": "Cria uma nova Nota Fiscal no SQL Server com status inicial 'Aberta' e calcula o valor total (130.00)."
					},
					"response": []
				},
				{
					"name": "2.2 Listar Todas as Notas Fiscais",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais?page=1&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Número da página"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Itens por página"
								},
								{
									"key": "status",
									"value": "Aberta",
									"disabled": true,
									"description": "Filtro por status (Aberta, EmProcessamento, Fechada, Cancelada)"
								}
							]
						},
						"description": "Retorna a lista paginada de Notas Fiscais salvas com envelope { items, pagination }."
					},
					"response": []
				},
				{
					"name": "2.3 Obter Nota Fiscal por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais",
								"1"
							]
						},
						"description": "Retorna os detalhes da Nota Fiscal por ID numérico ou UUID."
					},
					"response": []
				},
				{
					"name": "2.4 Imprimir / Finalizar Nota Fiscal (Publica Evento no RabbitMQ)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Correlation-ID",
								"value": "postman-corr-id-12345",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais/1/imprimir",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais",
								"1",
								"imprimir"
							]
						},
						"description": "Verifica se a Nota Fiscal está 'Aberta', altera o status para 'Fechada' no SQL Server e dispara o evento NotaFiscalEmitidaEvent para o RabbitMQ com X-Correlation-ID."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Validações e Tratamento de Erros",
			"item": [
				{
					"name": "3.1 Erro - Re-impressão de Nota Já Fechada (Status Inválido 400)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais/1/imprimir",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais",
								"1",
								"imprimir"
							]
						},
						"description": "Tenta imprimir novamente uma Nota Fiscal que já está 'Fechada'. Deve retornar HTTP 400 Bad Request."
					},
					"response": []
				},
				{
					"name": "3.2 Erro - Criar Nota Fiscal Sem Itens (400 Bad Request)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itens\": []\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais"
							]
						},
						"description": "Tenta criar uma Nota Fiscal sem itens. Deve retornar erro de validação 400 Bad Request."
					},
					"response": []
				},
				{
					"name": "3.3 Erro - Nota Fiscal Não Encontrada (404 Not Found)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/notas-fiscais/999",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"notas-fiscais",
								"999"
							]
						},
						"description": "Busca por um ID inexistente no banco de dados. Deve retornar HTTP 404 Not Found."
					},
					"response": []
				}
			]
		}
	]
}
