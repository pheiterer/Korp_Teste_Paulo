		"name": "API Gateway (YARP, WebSockets SignalR & Observabilidade)",
		"description": "Collection do Postman para testar o API Gateway YARP em .NET 10, incluindo roteamento proxied para Estoque e Faturamento, endpoints de observabilidade, métricas Prometheus e Hub SignalR para WebSockets.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
