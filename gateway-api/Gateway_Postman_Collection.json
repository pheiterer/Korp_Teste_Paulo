			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Observabilidade, Saúde & WebSockets Hub",
			"item": [
				{
					"name": "1.1 Status Raiz do Gateway",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								""
							]
						},
						"description": "Retorna o status do API Gateway YARP e SignalR Hub."
					},
					"response": []
				},
				{
					"name": "1.2 Health Check do Gateway",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Endpoint de verificação de saúde nativa do Gateway."
					},
					"response": []
				},
				{
					"name": "1.3 Métricas Prometheus Gateway",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/metrics",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"metrics"
							]
						},
						"description": "Expõe métricas do Gateway em formato Prometheus."
					},
					"response": []
				},
				{
					"name": "1.4 SignalR Negotiation (WebSockets)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/hubs/notificacoes/negotiate?negotiateVersion=1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"hubs",
								"notificacoes",
								"negotiate"
							],
							"query": [
								{
									"key": "negotiateVersion",
									"value": "1"
								}
							]
						},
						"description": "Endpoint de negociação de protocolo do SignalR Hub para conexões de cliente WebSockets."
					},
					"response": []
				},
				{
					"name": "1.5 Teste de Correlation ID no Gateway",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Correlation-ID",
								"value": "gateway-postman-test-777",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Valida se o middleware do Gateway injeta e propaga o X-Correlation-ID nos cabeçalhos HTTP."
					},
					"response": []
				}
			]
		},
