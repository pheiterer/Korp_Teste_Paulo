{
	"info": {
		"_postman_id": "e9b28f32-8f12-4c22-921a-4c2d6f512345",
		"name": "API de Estoque (C# .NET 10 - Completa)",
		"description": "Collection completa para testes manuais dos endpoints do microsserviço de Estoque (.NET 10), incluindo cadastro de produtos, consulta por filtro/código/ID, Health Checks, Métricas Prometheus e Rastreabilidade via Correlation ID.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Observabilidade & Saúde",
			"item": [
				{
					"name": "1.1 Health Check Completo (PostgreSQL, Redis e RabbitMQ)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Verifica a saúde do PostgreSQL, Redis, RabbitMQ e MassTransit. Deve retornar HTTP 200 OK com status 'Healthy' e cabeçalho X-Correlation-ID."
					},
					"response": []
				},
				{
					"name": "1.2 Métricas Prometheus",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/metrics",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"metrics"
							]
						},
						"description": "Retorna métricas em formato Prometheus para consumo pelo Grafana/Prometheus."
					},
					"response": []
				},
				{
					"name": "1.3 Teste de Correlation ID Customizado",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Correlation-ID",
								"value": "postman-test-correlation-99999",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Envia um X-Correlation-ID customizado e valida que a API preserva e retorna o mesmo ID nos cabeçalhos da resposta."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Gestão de Produtos",
			"item": [
				{
					"name": "2.1 Criar Produto (Sucesso)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigo\": \"PRD-001\",\n  \"descricao\": \"Parafuso Sextavado Zincado 3/8 x 2\",\n  \"saldoInicial\": 150\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/produtos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"produtos"
							]
						},
						"description": "Cadastra um novo produto no Estoque. Deve retornar 201 Created com cabeçalho Location."
					},
					"response": []
				},
				{
					"name": "2.2 Criar Outro Produto (Porca)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigo\": \"PRD-002\",\n  \"descricao\": \"Porca Sextavada 3/8\",\n  \"saldoInicial\": 300\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/produtos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"produtos"
							]
						},
						"description": "Cadastra outro produto no Estoque."
					},
					"response": []
				},
				{
					"name": "2.3 Listar Todos os Produtos (Com Busca)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/produtos?busca=Parafuso",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"produtos"
							],
							"query": [
								{
									"key": "busca",
									"value": "Parafuso"
								}
							]
						},
						"description": "Retorna a lista de produtos filtrando pelo termo de busca."
					},
					"response": []
				},
				{
					"name": "2.4 Obter Produto por Código",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/produtos/codigo/PRD-001",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"produtos",
								"codigo",
								"PRD-001"
							]
						},
						"description": "Obtém os detalhes de um produto pelo seu código de produto."
					},
					"response": []
				},
				{
					"name": "2.5 Obter Produto por ID (GUID)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/produtos/00000000-0000-0000-0000-000000000000",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"produtos",
								"00000000-0000-0000-0000-000000000000"
							]
						},
						"description": "Obtém os detalhes de um produto pelo seu identificador GUID. Substitua o GUID pelo ID retornado na criação."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Validações e Erros (RFC 7807)",
			"item": [
				{
					"name": "3.1 Erro - Saldo Negativo (FluentValidation)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigo\": \"PRD-ERR\",\n  \"descricao\": \"Produto Inválido\",\n  \"saldoInicial\": -10\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/produtos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"produtos"
							]
						},
						"description": "Valida que o middleware global converte erros de validação no padrão RFC 7807 (ValidationProblemDetails 400 Bad Request)."
					},
					"response": []
				},
				{
					"name": "3.2 Erro - Código Duplicado",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigo\": \"PRD-001\",\n  \"descricao\": \"Parafuso Duplicado\",\n  \"saldoInicial\": 50\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/produtos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"produtos"
							]
						},
						"description": "Tenta cadastrar o mesmo código PRD-001 novamente. Deve retornar HTTP 400 Bad Request informando que o código já está em uso."
					},
					"response": []
				},
				{
					"name": "3.3 Erro - Produto Não Encontrado (404)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/produtos/00000000-0000-0000-0000-000000000000",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"produtos",
								"00000000-0000-0000-0000-000000000000"
							]
						},
						"description": "Busca um GUID inexistente. Deve retornar HTTP 404 Not Found no formato ProblemDetails RFC 7807."
					},
					"response": []
				}
			]
		}
	]
}
